<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ Auto Backup / device-transfer rules (spec §6.7) — same exclusions as backup_rules.xml
     for the pre-31 path: raw SQLite files and photos never leave the device, only the gzipped
     JSON snapshot KrotonBackupAgent writes. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="kroton.db" />
        <exclude domain="database" path="kroton.db-wal" />
        <exclude domain="database" path="kroton.db-shm" />
        <exclude domain="file" path="photos/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="kroton.db" />
        <exclude domain="database" path="kroton.db-wal" />
        <exclude domain="database" path="kroton.db-shm" />
        <exclude domain="file" path="photos/" />
    </device-transfer>
</data-extraction-rules>
